# LLM Provider: "ollama", "huggingface", or "groq" (for test/cloud inference)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest

# Groq API Configuration (for test / development mode)
# When LLM_PROVIDER=groq, set your Groq API key below:
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local ROCm / Hugging Face Embeddings
# Uses local sentence-transformers running on AMD GPU (ROCm) or CPU fallback
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local Qdrant Configuration
# Stores vectors on local disk without cloud accounts
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION=web_knowledge_league

# Scraping & Retrieval Parameters
MAX_SEARCH_RESULTS=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
PLAYWRIGHT_HEADLESS=true
USE_DYNAMIC_SCRAPING=false

# ROCm / Device configuration ("auto", "cuda", or "cpu")
DEVICE=auto
